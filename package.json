{
  "name": "cocosinspector",
  "version": "2.2.8",
  "description": "Cocos Creator 3.x / 2.x 节点树查看器 Chrome 扩展",
  "main": "dist/content.js",
  "scripts": {
    "repack": "node tools/repack-super-html.mjs",
    "cocos-bridge": "node tools/mcp-cocos-inspector/bridge-daemon.mjs",
    "cocos-autotest": "node tools/mcp-cocos-inspector/autotest.mjs",
    "cocos-export-pack": "node tools/mcp-cocos-inspector/export-pack.mjs",
    "cocos-scene-to-creator": "node tools/mcp-cocos-inspector/scene-to-creator.mjs",
    "extract-har-particles": "node tools/mcp-cocos-inspector/extract-har-particles.mjs",
    "unpack-spine": "node tools/unpack-spine-export.mjs",
    "cocos-repack": "node tools/mcp-cocos-inspector/repack-latest.mjs",
    "repack-web": "npm run start --prefix tools/repack-web",
    "cocos-style-flow": "node tools/mcp-cocos-inspector/style-replace-flow.mjs",
    "cocos-prepare-sprite": "node tools/mcp-cocos-inspector/prepare-sprite-replace.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "dev": "node scripts/build.mjs",
    "prod": "node scripts/build.mjs --minify",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "package": "npm run prod && cd dist && tar -a -c -f ../cocos-inspector.zip *"
  },
  "keywords": [
    "cocos",
    "cocos-creator-3",
    "inspector",
    "chrome-extension"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "sharp": "^0.34.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  }
}
